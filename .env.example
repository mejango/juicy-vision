# Public frontend build configuration. Do not put secrets in VITE_* variables.
VITE_API_URL=http://localhost:3004
VITE_WALLETCONNECT_PROJECT_ID=
VITE_TESTNET_MODE=false
VITE_RELAYR_APP_ID=

# Reproducible release metadata. Railway should set BUILD_SHA from
# RAILWAY_GIT_COMMIT_SHA and SOURCE_DATE_EPOCH from the source commit time.
BUILD_SHA=development
SOURCE_DATE_EPOCH=0
DEPLOY_ENV=development
ALLOW_SAME_ORIGIN_API=false
