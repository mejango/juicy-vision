# Official multi-platform Node image, pinned to the reviewed manifest digest.
FROM node:26.5.0-bookworm-slim@sha256:2d49d876e96237d76de412761cf05dbfe5aee325cc4406a4d41d5824c5bb8beb AS build

WORKDIR /app
RUN npm install --global npm@12.0.1 --no-audit --no-fund
ENV NODE_ENV=development
ARG BUILD_SHA
ARG RAILWAY_GIT_COMMIT_SHA
ARG SOURCE_DATE_EPOCH=0
ARG VITE_API_URL=""
ARG VITE_WALLETCONNECT_PROJECT_ID=""
ARG VITE_TESTNET_MODE=false
ARG VITE_RELAYR_APP_ID=""
ARG DEPLOY_ENV=development
ARG ALLOW_SAME_ORIGIN_API=false
ENV BUILD_SHA=${BUILD_SHA:-${RAILWAY_GIT_COMMIT_SHA}} \
    SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH} \
    VITE_API_URL=${VITE_API_URL} \
    VITE_WALLETCONNECT_PROJECT_ID=${VITE_WALLETCONNECT_PROJECT_ID} \
    VITE_TESTNET_MODE=${VITE_TESTNET_MODE} \
    VITE_RELAYR_APP_ID=${VITE_RELAYR_APP_ID} \
    DEPLOY_ENV=${DEPLOY_ENV} \
    ALLOW_SAME_ORIGIN_API=${ALLOW_SAME_ORIGIN_API}

COPY package.json package-lock.json .npmrc ./
RUN npm ci --ignore-scripts --no-audit --no-fund && npm run deps:check
COPY . .
# Keep build tooling installed above, but compile the shipped bundle against
# production framework exports.
ENV NODE_ENV=production
RUN npm run check:release-config && npm run build && npm run check:bundle

# Official multi-platform unprivileged Nginx image, pinned to the reviewed manifest digest.
FROM nginxinc/nginx-unprivileged:1.31.3-alpine@sha256:18d67281256ded39ff65e010ae4f831be18f19356f83c60bc546492c7eb6dd23

ARG BUILD_SHA
ARG RAILWAY_GIT_COMMIT_SHA
ENV BUILD_SHA=${BUILD_SHA:-${RAILWAY_GIT_COMMIT_SHA}}
LABEL org.opencontainers.image.revision=${BUILD_SHA}
COPY docker/frontend.nginx.conf /etc/nginx/conf.d/default.conf
COPY docker/security-headers.inc /etc/nginx/security-headers.inc
COPY --from=build --chown=101:101 /app/dist/ /usr/share/nginx/html/

USER 101
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD ["wget", "--quiet", "--tries=1", "--spider", "http://127.0.0.1:8080/healthz"]
