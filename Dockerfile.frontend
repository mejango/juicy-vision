# Official multi-platform Node image, pinned to the reviewed manifest digest.
FROM node:22.16.0-bookworm-slim@sha256:048ed02c5fd52e86fda6fbd2f6a76cf0d4492fd6c6fee9e2c463ed5108da0e34 AS build

WORKDIR /app
ENV NODE_ENV=development
ARG BUILD_SHA=source-unknown
ARG SOURCE_DATE_EPOCH=0
ARG VITE_API_URL=""
ARG VITE_WALLETCONNECT_PROJECT_ID=""
ARG VITE_TESTNET_MODE=false
ARG DEPLOY_ENV=development
ARG ALLOW_SAME_ORIGIN_API=false
ENV BUILD_SHA=${BUILD_SHA} \
    SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH} \
    VITE_API_URL=${VITE_API_URL} \
    VITE_WALLETCONNECT_PROJECT_ID=${VITE_WALLETCONNECT_PROJECT_ID} \
    VITE_TESTNET_MODE=${VITE_TESTNET_MODE} \
    DEPLOY_ENV=${DEPLOY_ENV} \
    ALLOW_SAME_ORIGIN_API=${ALLOW_SAME_ORIGIN_API}

COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts && npm run deps:check
COPY . .
RUN npm run check:release-config && npm run build && npm run check:bundle

# Official multi-platform unprivileged Nginx image, pinned to the reviewed manifest digest.
FROM nginxinc/nginx-unprivileged:1.28.0-alpine@sha256:c97ff0bf7cbae369953c6da1232ec14ad9f971d66360c5698db0856a4cd657a0

ARG BUILD_SHA=source-unknown
LABEL org.opencontainers.image.revision=${BUILD_SHA}
COPY docker/frontend.nginx.conf /etc/nginx/conf.d/default.conf
COPY docker/security-headers.inc /etc/nginx/security-headers.inc
COPY --from=build --chown=101:101 /app/dist/ /usr/share/nginx/html/

USER 101
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD ["wget", "--quiet", "--tries=1", "--spider", "http://127.0.0.1:8080/healthz"]
