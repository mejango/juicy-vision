{
  "name": "juicyvision",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": "22.x",
    "npm": "10.9.x"
  },
  "scripts": {
    "dev": "vite",
    "dev:staging": "vite --mode staging",
    "build": "tsc -b && vite build",
    "build:staging": "tsc -b && vite build --mode staging",
    "typecheck": "npm run typecheck:app && npm run typecheck:e2e",
    "typecheck:app": "tsc --noEmit --pretty false",
    "typecheck:e2e": "tsc --project tsconfig.e2e.json --pretty false",
    "lint": "eslint .",
    "lint:ci": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "preview:staging": "vite preview --mode staging",
    "deploy:ipfs": "./deploy-ipfs.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage",
    "test:e2e": "playwright test --project=smoke --project=critical",
    "test:e2e:smoke": "playwright test --project=smoke",
    "test:e2e:critical": "playwright test --project=critical",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:flow": "playwright test --project=e2e-flows",
    "test:e2e:api": "playwright test --project=api-tests",
    "test:ux-bot": "playwright test --project=ux-bot",
    "test:ux-bot:auth": "UX_AUTHENTICATED=true playwright test --project=ux-bot -g 'Authenticated'",
    "test:ux-bot:real": "playwright test --project=ux-bot -g 'Real Backend'",
    "test:ux-bot:scenario": "playwright test --project=ux-bot e2e/ux-bot.spec.ts",
    "test:stress": "playwright test --project=stress",
    "test:responsive": "playwright test --project=responsive",
    "test:mobile": "playwright test --project=responsive -g 'Mobile'",
    "test:scenarios": "playwright test --project=scenarios",
    "test:scenarios:quick": "playwright test --project=scenarios -g 'main' --workers=2",
    "test:visual": "playwright test --project=visual",
    "test:visual:update": "playwright test --project=visual --update-snapshots",
    "test:full-suite": "npm run test:e2e && npm run test:ux-bot:real && npm run test:stress && npm run test:responsive",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:protocol": "node scripts/verify-protocol-parity.mjs",
    "check:writes": "node scripts/check-wallet-write-inventory.mjs",
    "check:release-config": "node scripts/validate-release-config.mjs",
    "check:source": "node scripts/check-source-invariants.mjs",
    "deps:check": "npm ls --all --omit=optional",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "check": "npm run deps:check && npm run audit:prod && npm run lint:ci && npm run typecheck && npm run check:source && npm run check:protocol && npm run check:writes && npm run test:ci && npm run build && npm run check:bundle && npm run test:e2e",
    "test:all": "npm run typecheck && npm run test:ci && npm run test:e2e"
  },
  "dependencies": {
    "@bananapus/nana-sdk-core": "^1.4.0",
    "@stripe/react-stripe-js": "^5.5.0",
    "@stripe/stripe-js": "^8.6.4",
    "@tanstack/react-query": "^5.62.0",
    "graphql": "^16.9.0",
    "graphql-request": "^7.1.2",
    "i18next": "^25.7.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.5.3",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^7.18.1",
    "react-syntax-highlighter": "^15.6.1",
    "recharts": "^3.6.0",
    "remark-gfm": "^4.0.0",
    "viem": "^2.55.5",
    "wagmi": "^2.14.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.112.3",
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.0.17",
    "@vitest/ui": "^4.0.17",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "fast-check": "^4.5.3",
    "globals": "^15.14.0",
    "jsdom": "^27.4.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^4.0.17",
    "workbox-window": "^7.3.0"
  }
}
