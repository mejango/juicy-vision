# Official multi-platform PostgreSQL image for local development, pinned to the
# reviewed patch/Alpine version and immutable manifest digest.
FROM postgres:18.4-alpine3.24@sha256:9a8afca54e7861fd90fab5fdf4c42477a6b1cb7d293595148e674e0a3181de15
# The database image owns only the pinned PostgreSQL runtime. The exact backend
# image remains the single schema authority and initializes/upgrades it with
# `deno task migrate`, matching the production rollout path.
