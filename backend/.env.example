# Server
PORT=3004
DENO_ENV=development
# Exact comma-separated browser origins. Production requires HTTPS and does not
# accept wildcards or look-alike domains. Add the stable custom IPFS gateway
# origin here if the frontend is served from one.
ALLOWED_ORIGINS=http://localhost:3003,http://127.0.0.1:3003
# Only enable when every request reaches the API through a trusted proxy that
# overwrites forwarding headers supplied by clients.
TRUST_PROXY=false

# Database (PostgreSQL)
DATABASE_URL=postgresql://localhost:5432/juicyvision

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
ENCRYPTION_MASTER_KEY=use-a-different-random-secret-of-at-least-32-characters
SESSION_DURATION_MS=604800000

# Cron Jobs
CRON_SECRET=your-secure-cron-secret-change-in-production

# Stripe (for fiat payments)
# Radar must be enabled for risk-based settlement delays to work
# Webhook events needed: checkout.session.completed, payment_intent.succeeded, charge.dispute.created, charge.refunded
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Anthropic (Claude API)
ANTHROPIC_API_KEY=sk-ant-...

# Reserves Wallet (hot wallet for executing payments)
# WARNING: Keep this secure! Consider using GCP Secret Manager in production
RESERVES_PRIVATE_KEY=0x...

# Project that receives paid AI deposits. Leave 0 to disable paid AI billing.
AI_BILLING_PROJECT_ID=0

# External API Keys (for proxy endpoints)
# Bendystraw - Get key from @peripheralist on X/Twitter
BENDYSTRAW_API_KEY=your-bendystraw-api-key
# TheGraph - Get key from https://thegraph.com/studio/
THEGRAPH_API_KEY=your-thegraph-api-key
# Ankr (optional) - Get key from https://www.ankr.com/rpc/
ANKR_API_KEY=your-ankr-api-key

# Redundant IPFS pinning. Filebase creates the canonical CID and Pinata pins
# that same CID. Keep both bearer credentials server-only.
IPFS_PINNING_ENABLED=false
FILEBASE_IPFS_RPC_TOKEN=
PINATA_JWT=
